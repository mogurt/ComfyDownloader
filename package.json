{
  "name": "comfy-downloader",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop application for downloading AI models to the correct ComfyUI directories, powered by aria2.",
  "license": "MIT",
  "author": "Li Kaixuan <mcyogurtg@gmail.com>",
  "type": "module",
  "homepage": "https://github.com/mogurt/ComfyDownloader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mogurt/ComfyDownloader.git"
  },
  "bugs": {
    "url": "https://github.com/mogurt/ComfyDownloader/issues"
  },
  "keywords": [
    "comfyui",
    "ai-models",
    "huggingface",
    "civitai",
    "model-download",
    "desktop-app",
    "tauri"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
